schema_name = "ffhn.target"
schema_version = 4
target_id = "demo-file-bad"
display_name = "File Demo Bad"
enabled = true

[target]
kind = "file"
file_path = "/tmp/demo.html"

[fetch]
engine = "file"
timeout_ms = 20000
user_agent = "bogus-agent"
accept = "text/html"
follow_redirects = false
max_bytes = 2000000

[selection]
kind = "css_selector"
selector = "main"
match = "single"

[compare]
basis = "outer_html"
rewrite_urls = false
canonicalization = []
