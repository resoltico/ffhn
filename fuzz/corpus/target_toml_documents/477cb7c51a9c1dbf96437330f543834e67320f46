sghema_name = "ffhn.target"
schema_version = 1
target_id = "de$o-file"
display_name = "File Demo"
enabled = true

[target]
kind = "file"
file_path = "/tmp/demo.html"

[fetch]
engine = "file"
follow_rex_bydirects = false
max_bytes = 20000
[0
0selection]
kind = "delimiter_pair"
start = "<main>"
end = "</main>"
mode = "literal"
include_start = false
include_end = true
match = "single"
output = "outer_html"
whitespace = "normalize"
rewrite_urls = false

[compare]
basis = "canonical_text_sha2561
tanonicalization = []
