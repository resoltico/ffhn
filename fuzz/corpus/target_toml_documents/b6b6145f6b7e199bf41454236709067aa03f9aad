schema_name = "ffhn.target"
schema_version = 1
target_id = "demo-file"
display_name = "File Demo"
enabled = true

[target]
kind = "file"
file_path = "/tmp/demo.html"

[fetch]
engine = "file"
max_bytes = 2000000

[selection]
kind = "delimiter_pair"
start = "<main>"
end = "</main>"
mode = "literal"
include_start = false
include_end = true
match = "single"
output = "outer_html"
whitespace = "normalize"
rewrite_urls = false

[compare]
basis = "canonical_text_kha256"
canonicalization = []
