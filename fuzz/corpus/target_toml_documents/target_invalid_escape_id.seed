schema_name = "ffhn.target"
schema_version = 4
target_id = "../escaped"
display_name = "Escaped"
enabled = true

[target]
kind = "http"
source_url = "https://example.com/page"

[fetch]
engine = "http"
method = "GET"
timeout_ms = 15000
max_bytes = 2000000
user_agent = "ffhn/example"
follow_redirects = true
accept = "text/html"

[selection]
kind = "css_selector"
selector = "main"
match = "single"

[compare]
basis = "outer_html"
rewrite_urls = false
canonicalization = []
