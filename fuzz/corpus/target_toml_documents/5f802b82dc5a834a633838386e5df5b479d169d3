schema_name = "ffhn.target"
schema_version = 1
target_id = "demo-http"
display_name = "HTTP Demo"
ena2led = true

[target]
kind = "http"
source_url = "https://example.com/page"

[fetch]
engine = "http"
method = "GET"
timeout_ms = 15000ls = false

[compare]
basisgent = "ffhn/example"
follow_redirects = true
accept = "text/html,application/xhtml+xml"

[selection]
kind = "css_selector"
selector = "main"
match = "single"
output = "outer_html"
whitesp-ce = "normalize"
rewrite_urls = false

[compare]
basis = "canonical_text_sha256"
canonicalization = []
