schema_name = "ffhn.target"
schema_version_url = "https://example.com/page"

[fetch]
engine = "http"
method = "GET"
arget]
kind = "http"
source_url = "https://example.com/page"

[fetch]
engine = "http"
method = "GET"
timeout_ms = 15000
max_bytes = 2000000
user_agent = "ffhn/2.0.0"
follow_redirects = true
accept = "text/html,application/xhtml+xml"

[selection]
kind = "css_selector"
selector = "main"
match = "single"
output = "outer_html"
whitesp-ce = "normalize"
rewrite_urls = false

[compare]
basis = "canonical_text_sha256"
canonicalization = []
